# Common build settings
common --enable_bzlmod

# Python configuration
# For dev dependencies, we want to use the system Python interpreter
# This prevents downloading a hermetic Python runtime
# common --check_direct_dependencies=off

# C++ configuration
build --cxxopt=-std=c++23
build --cxxopt=-Wall
build --cxxopt=-Wextra
build --cxxopt=-Wpedantic
build --cxxopt=-Werror
# build --cxxopt=-fno-strict-aliasing

# Optimization levels
build:release --compilation_mode=opt
build:release --cxxopt=-DNDEBUG
build:release --strip=always

build:debug --compilation_mode=dbg
build:debug --cxxopt=-DDEBUG
build:debug --cxxopt=-g

# Default to debug for development
build --config=debug

# Test settings
test --test_output=errors
test --test_summary=short
